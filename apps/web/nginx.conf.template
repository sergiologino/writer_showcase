map $http_x_publisher_external_host $publisher_external_host {
    default $http_x_publisher_external_host;
    "" $http_x_forwarded_host;
}

map $publisher_external_host $publisher_forwarded_host {
    default $publisher_external_host;
    "" $host;
}

map $http_x_publisher_external_proto $publisher_external_proto {
    default $http_x_publisher_external_proto;
    "" $http_x_forwarded_proto;
}

map $publisher_external_proto $publisher_forwarded_proto {
    default $publisher_external_proto;
    "" $scheme;
}

map $http_x_publisher_external_port $publisher_external_port {
    default $http_x_publisher_external_port;
    "" $http_x_forwarded_port;
}

map $publisher_external_port $publisher_forwarded_port {
    default $publisher_external_port;
    "" $server_port;
}

server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $publisher_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $publisher_forwarded_host;
        proxy_set_header X-Forwarded-Proto $publisher_forwarded_proto;
        proxy_set_header X-Forwarded-Port $publisher_forwarded_port;
    }

    location /oauth2/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $publisher_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $publisher_forwarded_host;
        proxy_set_header X-Forwarded-Proto $publisher_forwarded_proto;
        proxy_set_header X-Forwarded-Port $publisher_forwarded_port;
    }

    location /login/oauth2/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $publisher_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $publisher_forwarded_host;
        proxy_set_header X-Forwarded-Proto $publisher_forwarded_proto;
        proxy_set_header X-Forwarded-Port $publisher_forwarded_port;
    }

    location = /robots.txt {
        proxy_pass ${API_UPSTREAM}/robots.txt;
        proxy_http_version 1.1;
        proxy_set_header Host $publisher_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $publisher_forwarded_host;
        proxy_set_header X-Forwarded-Proto $publisher_forwarded_proto;
        proxy_set_header X-Forwarded-Port $publisher_forwarded_port;
    }

    location = /sitemap.xml {
        proxy_pass ${API_UPSTREAM}/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $publisher_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $publisher_forwarded_host;
        proxy_set_header X-Forwarded-Proto $publisher_forwarded_proto;
        proxy_set_header X-Forwarded-Port $publisher_forwarded_port;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
